{
  "name": "react-data-import",
  "version": "1.0.0-alpha.2",
  "description": "Import .xlsx and .csv files into React apps as { columns, data } datasets. Built on javascript-excel.",
  "license": "MIT",
  "author": "Afzal Ahmad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/securedeveloper/react-data-import.git",
    "directory": "packages/react-data-import"
  },
  "bugs": {
    "url": "https://github.com/securedeveloper/react-data-import/issues"
  },
  "homepage": "https://github.com/securedeveloper/react-data-import#readme",
  "keywords": [
    "react",
    "excel",
    "xlsx",
    "csv",
    "import",
    "spreadsheet"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=17 <20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint --strict && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "javascript-excel": "^2.0.0-alpha.6"
  }
}
